---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.category === 'blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="section container container-narrow">
    <header>
      <p class="eyebrow">
        {post.data.category}
        {post.data.archived && <span class="archived-flag">Archived</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="meta">
        <time datetime={post.data.publishedDate.toISOString()}>
          {post.data.publishedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        &middot; {post.data.author}
        {post.data.updatedDate && (
          <> &middot; updated {post.data.updatedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</>
        )}
      </p>
      {post.data.heroImage && (
        <img src={post.data.heroImage} alt="" class="hero-image" loading="eager" />
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .archived-flag {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 2px 8px;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .lede {
    font-size: var(--fs-lg);
    color: var(--color-muted);
  }

  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-8);
  }

  .hero-image {
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin: var(--space-4) 0 var(--space-8);
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
  }

  .prose :global(h3) {
    margin-top: var(--space-8);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    font-size: var(--fs-lg);
    line-height: 1.7;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-brand);
    padding-left: var(--space-4);
    margin-left: 0;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
