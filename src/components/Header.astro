---
const nav = [
  { label: 'Technology', href: '/technology/' },
  { label: 'Evidence', href: '/evidence/' },
  { label: 'For Clinics', href: '/clinics/' },
  { label: 'For Athletes', href: '/athletes/' },
  { label: 'Investors', href: '/investors/' },
  { label: 'About', href: '/about/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header" data-nav>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="MuJo — home">
      <img src="/images/brand/logo-grey.png" alt="MuJo" width="120" height="39" />
    </a>

    <button
      type="button"
      class="hamburger"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Open navigation menu"
      data-nav-toggle
    >
      <span class="bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <nav id="primary-nav" aria-label="Primary" class="primary-nav" data-nav-panel>
      <ul class="nav-list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="mobile-only">
          <a href="/contact/" class="button contact-cta-mobile">Contact</a>
        </li>
      </ul>
    </nav>

    <a href="/contact/" class="button contact-cta desktop-only">Contact</a>
  </div>
</header>

<script is:inline>
  // Mobile nav toggle. Uses data-open on the header for state — simpler
  // and more reliable across the Astro scoped-CSS boundary than a class.
  (function () {
    var header = document.querySelector('[data-nav]');
    if (!header) return;
    var toggle = header.querySelector('[data-nav-toggle]');
    var panel = header.querySelector('[data-nav-panel]');
    if (!toggle || !panel) return;

    function setOpen(open) {
      if (open) header.setAttribute('data-open', '');
      else header.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    }

    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(!header.hasAttribute('data-open'));
    });

    Array.prototype.forEach.call(panel.querySelectorAll('a'), function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', function (e) {
      if (!header.hasAttribute('data-open')) return;
      if (!header.contains(e.target)) setOpen(false);
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--brand-grey);
    color: var(--brand-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand img {
    height: 2.25rem;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  /* ─── Hamburger button ─── */
  .hamburger {
    order: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.6rem;
    color: var(--brand-white);
    cursor: pointer;
    transition: background 120ms ease;
  }

  .hamburger:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .hamburger:focus-visible {
    outline: 2px solid var(--brand-mint);
    outline-offset: 2px;
  }

  .bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .bars span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 200ms ease, opacity 200ms ease;
  }

  [data-nav][data-open] .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  [data-nav][data-open] .bars span:nth-child(2) {
    opacity: 0;
  }
  [data-nav][data-open] .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ─── Nav panel (mobile-first: hidden dropdown; desktop: inline flex) ─── */
  .primary-nav {
    order: 4;
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--brand-grey);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    max-height: 0;
    overflow: hidden;
    transition: max-height 240ms ease;
    /* keep off-screen for a11y while collapsed */
    visibility: hidden;
  }

  [data-nav][data-open] .primary-nav {
    max-height: 80vh;
    visibility: visible;
    box-shadow: 0 20px 30px -20px rgba(0, 0, 0, 0.4);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    gap: var(--space-2);
  }

  .nav-list a {
    display: block;
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
    color: #d6d1cf;
    font-weight: var(--fw-medium);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-list a[aria-current='page'] {
    color: var(--brand-mint);
  }

  .nav-list a:hover {
    color: var(--brand-white);
  }

  .contact-cta-mobile {
    display: inline-block;
    background: var(--brand-mint);
    color: var(--brand-grey);
    padding: var(--space-3) var(--space-5);
    text-align: center;
    margin-top: var(--space-3);
    border-radius: var(--radius-md);
    font-weight: var(--fw-bold);
  }

  .desktop-only {
    display: none;
  }

  .mobile-only {
    display: block;
  }

  /* ─── Desktop: hide hamburger, inline the nav ─── */
  @media (min-width: 900px) {
    .hamburger {
      display: none;
    }

    .primary-nav {
      order: 2;
      position: static;
      inset: auto;
      max-height: none;
      overflow: visible;
      visibility: visible;
      background: transparent;
      border-bottom: none;
      box-shadow: none;
    }

    .nav-list {
      flex-direction: row;
      gap: var(--space-6);
      padding: 0;
    }

    .nav-list a {
      padding: var(--space-2) 0;
      border-bottom: 2px solid transparent;
    }

    .nav-list a[aria-current='page'] {
      color: var(--brand-mint);
      border-bottom-color: var(--brand-mint);
    }

    .desktop-only {
      display: inline-block;
    }

    .mobile-only {
      display: none;
    }
  }

  /* ─── Desktop contact button ─── */
  .contact-cta {
    padding: var(--space-2) var(--space-5);
    font-size: 0.95rem;
    background: var(--brand-mint);
    color: var(--brand-grey);
    order: 3;
  }

  .contact-cta:hover {
    background: var(--brand-white);
    color: var(--brand-grey);
    transform: none;
  }
</style>
