---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const members = (await getCollection('team'))
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  members.map(async (m) => {
    const { Content } = await render(m);
    return { data: m.data, id: m.id, Content };
  })
);
---
<BaseLayout title="Team" description="The MuJo Panacea leadership team.">
  <section class="section container">
    <header class="page-header">
      <h1>Team</h1>
      <p class="lede">The people running MuJo Panacea.</p>
    </header>

    <ul class="team-grid">
      {rendered.map((m) => (
        <li id={m.id} class="team-card">
          <div class="photo">
            <img src={m.data.photo ?? '/images/team/placeholder-avatar.svg'} alt="" loading="lazy" width="320" height="320" />
          </div>
          <div class="body">
            <h2>{m.data.name}</h2>
            <p class="role">{m.data.role}</p>
            {m.data.summary && <p class="summary">{m.data.summary}</p>}
            <details class="bio-toggle">
              <summary>
                <span class="toggle-label">
                  <span class="closed-label">Read bio</span>
                  <span class="open-label">Hide bio</span>
                </span>
                <svg class="chevron" width="14" height="14" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5 7l5 6 5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="bio">
                <m.Content />
                {m.data.linkedin && (
                  <p class="links">
                    <a href={m.data.linkedin} rel="noopener" target="_blank">LinkedIn &rarr;</a>
                  </p>
                )}
              </div>
            </details>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-8); }
  .lede { font-size: var(--fs-lg); color: var(--color-muted); }

  .team-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 0;
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .team-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .photo {
    background: var(--color-subtle);
    aspect-ratio: 1 / 1;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .body {
    padding: var(--space-6);
  }

  .team-card h2 {
    margin: 0 0 var(--space-1);
    color: var(--color-fg);
  }

  .role {
    color: var(--color-brand-strong);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    margin: 0 0 var(--space-4);
  }

  .summary {
    font-size: var(--fs-lg);
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
    /* Keep the visible summary to two lines so cards line up */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── Disclosure toggle for the full bio ─── */
  .bio-toggle {
    margin-top: auto;
  }

  .bio-toggle > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    color: var(--color-brand-strong);
    font-weight: var(--fw-bold);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    user-select: none;
  }

  .bio-toggle > summary::-webkit-details-marker,
  .bio-toggle > summary::marker {
    display: none;
    content: '';
  }

  .bio-toggle > summary:hover {
    color: var(--color-fg);
  }

  .bio-toggle > summary:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .open-label {
    display: none;
  }

  .bio-toggle[open] .closed-label {
    display: none;
  }

  .bio-toggle[open] .open-label {
    display: inline;
  }

  .chevron {
    transition: transform 180ms ease;
  }

  .bio-toggle[open] .chevron {
    transform: rotate(180deg);
  }

  .bio {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-2);
    animation: fadein 220ms ease;
  }

  @keyframes fadein {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .bio :global(p) {
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  .bio :global(strong) {
    color: var(--color-fg);
  }

  .links a {
    color: var(--color-brand-strong);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-fg);
  }
</style>
