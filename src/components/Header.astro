---
const nav = [
  { label: 'Technology', href: '/technology/' },
  { label: 'Evidence', href: '/evidence/' },
  { label: 'For Athletes', href: '/athletes/' },
  { label: 'Investors', href: '/investors/' },
  { label: 'About', href: '/about/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="header-inner-wrap">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="MuJo — home">
      <img src="/images/brand/logo-grey.png" alt="MuJo" width="120" height="39" />
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/contact/" class="button contact-cta">Contact</a>
  </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--brand-grey);
    color: var(--brand-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-inner-wrap {
    /* Placeholder for a wider container if we ever need one; leaves room
       for a future top-utility strip above the nav. */
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand img {
    height: 2.25rem;
    width: auto;
    display: block;
    /* Grey logo inverted to white to sit on the dark header */
    filter: brightness(0) invert(1);
  }

  .nav-list {
    display: none;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    text-decoration: none;
    color: #d6d1cf;
    font-weight: var(--fw-medium);
    padding-block: var(--space-2);
    transition: color 120ms ease;
  }

  .nav-list a[aria-current='page'] {
    color: var(--brand-mint);
    border-bottom: 2px solid var(--brand-mint);
  }

  .nav-list a:hover {
    color: var(--brand-white);
  }

  .contact-cta {
    padding: var(--space-2) var(--space-5);
    font-size: 0.95rem;
    background: var(--brand-mint);
    color: var(--brand-grey);
  }

  .contact-cta:hover {
    background: var(--brand-white);
    color: var(--brand-grey);
    transform: none;
  }

  @media (min-width: 800px) {
    .nav-list {
      display: flex;
    }
  }
</style>
