---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="MUJO"
  description="Clinically grounded shoulder rehabilitation devices and software from MUJO Panacea."
>
  <section class="hero">
    <div class="container container-narrow">
      <p class="eyebrow">Skeleton page &middot; Phase 2 in progress</p>
      <h1>Clinically grounded shoulder rehabilitation.</h1>
      <p class="lede">
        MUJO builds musculoskeletal rehabilitation equipment for clinicians, sports
        institutions, and research partners. This page is a scaffold — real content
        arrives in Phase 3.
      </p>
      <div class="cta-row">
        <a href="/technology/" class="button">Explore the technology</a>
        <a href="/contact/" class="button button-outline">Contact us</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Latest from the site</h2>
    {posts.length === 0 ? (
      <p><em>No posts yet — seed content lands as the migration progresses.</em></p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <small>
                {post.data.category} &middot; {post.data.publishedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </small>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
    background: linear-gradient(180deg, var(--color-subtle) 0%, var(--color-bg) 100%);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: clamp(2.25rem, 4vw + 1rem, 3.75rem);
  }

  .lede {
    font-size: var(--fs-lg);
    color: var(--color-muted);
    max-width: 40rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  .post-list a {
    display: block;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, transform 120ms ease;
  }

  .post-list a:hover {
    border-color: var(--color-brand);
    transform: translateY(-2px);
  }

  .post-list h3 {
    color: var(--color-brand);
    margin-bottom: var(--space-2);
  }

  .post-list small {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
  }

  @media (min-width: 720px) {
    .post-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
