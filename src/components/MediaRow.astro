---
/**
 * Alternating text / image content band.
 *
 * <MediaRow image="/images/site/mujo-device-1.jpg" alt="MuJo device" flip>
 *   ## Heading
 *   Body copy.
 * </MediaRow>
 *
 * `flip` reverses image / text order.
 * `background` sets the band colour:
 *   - "white" (default): use for images that themselves have a white background
 *     — e.g. product shots on white — so the image edges disappear into the panel
 *   - "subtle": use for images with natural / photographic backgrounds — clinical
 *     scenes, sports scenes — creates the zig-zag rhythm between rows
 *   - "grey": inverted band for high-contrast product callouts
 */

interface Props {
  image: string;
  alt: string;
  flip?: boolean;
  background?: 'white' | 'subtle' | 'grey';
}

const { image, alt, flip = false, background = 'white' } = Astro.props;
---
<section
  class:list={[
    'media-row',
    flip && 'flip',
    background === 'subtle' && 'bg-subtle',
    background === 'grey' && 'bg-grey',
  ]}
>
  <div class="row-inner">
    <div class="media">
      <img src={image} alt={alt} loading="lazy" />
    </div>
    <div class="text">
      <slot />
    </div>
  </div>
</section>

<style>
  .media-row {
    padding-block: var(--space-16);
    max-width: none;
    /* Break out of any parent .container so the band goes edge-to-edge */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .bg-subtle {
    background: var(--color-subtle);
  }

  .bg-grey {
    background: var(--brand-grey);
    color: var(--brand-white);
  }

  .bg-grey .text :global(h2),
  .bg-grey .text :global(h3),
  .bg-grey .text :global(strong) {
    color: var(--brand-white);
  }

  .bg-grey .text :global(p),
  .bg-grey .text :global(ul),
  .bg-grey .text :global(ol) {
    color: #d6d1cf;
  }

  .row-inner {
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    gap: var(--space-12);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 800px) {
    .row-inner {
      grid-template-columns: 1fr 1fr;
    }

    .flip .row-inner {
      direction: rtl;
    }
    .flip .row-inner > * {
      direction: ltr;
    }
  }

  .media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .text :global(h2) {
    font-size: var(--fs-2xl);
    margin: 0 0 var(--space-4);
    color: var(--color-fg);
  }

  .text :global(h3) {
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-3);
    color: var(--color-brand-strong);
  }

  .text :global(p),
  .text :global(ul),
  .text :global(ol) {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 var(--space-4);
  }

  .text :global(p:last-child),
  .text :global(ul:last-child),
  .text :global(ol:last-child) {
    margin-bottom: 0;
  }

  .text :global(strong) {
    color: var(--color-fg);
  }

  .text :global(a) {
    color: var(--color-brand-strong);
    text-decoration: none;
    font-weight: var(--fw-bold);
  }

  .text :global(a:hover) {
    color: var(--color-fg);
  }
</style>
