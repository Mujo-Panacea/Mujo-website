---
import BaseLayout from './BaseLayout.astro';

// Astro passes MDX/Markdown frontmatter under `frontmatter`, but we also
// support direct props so this layout can be used from .astro pages too.
const frontmatter = (Astro.props as any).frontmatter ?? {};
const title: string = (Astro.props as any).title ?? frontmatter.title ?? 'MUJO';
const description: string | undefined = (Astro.props as any).description ?? frontmatter.description;
const brand: string | undefined = (Astro.props as any).brand ?? frontmatter.brand;
---
<BaseLayout title={title} description={description} brand={brand}>
  <article class="section container">
    <header class="page-header">
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-12);
    max-width: var(--container-narrow);
  }

  .lede {
    font-size: var(--fs-lg);
    color: var(--color-muted);
  }

  /* Prose content stays at a comfortable measure for reading; wider blocks
     (images, tables, alternating text-media rows) can override with their
     own max-width or `--prose-wide` helpers. */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4),
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(hr),
  .prose :global(.review-banner) {
    max-width: 46rem;
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    color: var(--color-brand-strong);
    font-size: var(--fs-2xl);
  }

  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: var(--fs-xl);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    font-size: var(--fs-lg);
    line-height: 1.7;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-brand);
    padding-left: var(--space-4);
    margin-left: 0;
    color: var(--color-muted);
    font-style: italic;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-6);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-12);
  }
</style>
