---
interface Partner {
  name: string;
  logo: string;
  height?: number;
}

interface Props {
  heading?: string;
  subheading?: string;
  partners?: Partner[];
}

const {
  heading = 'Working with and evaluated by',
  subheading = 'NHS trusts, Olympic-track sports institutes, research universities, and UK innovation funders.',
  partners = [
    { name: 'Royal National Orthopaedic Hospital', logo: '/images/partners/NHS-RNOH.png', height: 56 },
    { name: 'English Institute of Sport', logo: '/images/partners/logo-eios_crop.png', height: 44 },
    { name: 'University of Manchester', logo: '/images/partners/UniOfManchesterLogo.png', height: 44 },
    { name: 'Coventry University', logo: '/images/partners/Coventry_University_logo.png', height: 48 },
    { name: 'Innovate UK', logo: '/images/partners/Innovate-UK-1.png', height: 40 },
    { name: 'Circle Health Group', logo: '/images/partners/circle-logo.png', height: 44 },
    { name: 'Health eResearch Centre', logo: '/images/partners/HERC_2.png', height: 40 },
    { name: 'Institution of Engineering and Technology', logo: '/images/partners/IET_logo.png', height: 44 },
  ],
} = Astro.props;
---
<section class="partners" aria-labelledby="partners-heading">
  <div class="partners-inner">
    <header class="head">
      <p class="eyebrow" id="partners-heading">{heading}</p>
      {subheading && <p class="sub">{subheading}</p>}
    </header>
    <ul class="logo-row">
      {partners.map((p) => (
        <li>
          <img
            src={p.logo}
            alt={p.name}
            title={p.name}
            height={p.height ?? 44}
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners {
    background: var(--brand-white);
    padding-block: var(--space-16);
    border-block: 1px solid var(--color-border);
  }

  .partners-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .head {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    color: var(--color-brand-strong);
    font-weight: var(--fw-bold);
    margin: 0;
  }

  .sub {
    color: var(--color-muted);
    font-size: var(--fs-lg);
    max-width: 44rem;
    margin: var(--space-3) auto 0;
  }

  .logo-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-12);
    row-gap: var(--space-8);
  }

  .logo-row li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
  }

  .logo-row img {
    max-height: 3rem;
    width: auto;
    max-width: 12rem;
    /* Neutralise coloured logos so they read as a coherent strip;
       full colour returns on hover for identity confirmation. */
    filter: grayscale(1) opacity(0.7);
    transition: filter 200ms ease;
    object-fit: contain;
  }

  .logo-row img:hover {
    filter: grayscale(0) opacity(1);
  }
</style>
