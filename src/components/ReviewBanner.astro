---
// Shows a review / editorial-in-progress banner at the top of a page while
// content is being finalised. Removed as pages get their editorial pass.
---
<aside class="review-banner" role="note">
  <p class="label">Editorial review in progress</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .review-banner {
    border: 1px dashed var(--color-accent);
    background: rgba(214, 69, 69, 0.05);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-8);
    font-size: 0.9rem;
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0 var(--space-2);
  }

  .body :global(p) {
    margin: 0;
    color: var(--color-fg);
    font-size: 0.95rem;
  }
</style>
